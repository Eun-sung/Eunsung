{
  "name": "rsi-watch",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public" },
  // id를 비워두면 첫 배포 때 KV 네임스페이스가 자동 생성됩니다.
  "kv_namespaces": [{ "binding": "KV" }],
  // 평일 내내 5분마다 확인합니다: 프리마켓~애프터마켓 + 주간거래(뉴욕 20:00~04:00). (UTC 기준)
  "triggers": { "crons": ["*/5 * * * MON-FRI", "*/5 0-1 * * SAT"] },
  "observability": { "enabled": true }
}
