{
  "name": "rsi-watch",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public" },
  // id를 비워두면 첫 배포 때 KV 네임스페이스가 자동 생성됩니다.
  "kv_namespaces": [{ "binding": "KV" }],
  // 미국 정규장 시간대(서머타임/표준시 모두 포함)에 5분마다 RSI를 확인합니다. (UTC 기준)
  "triggers": { "crons": ["*/5 13-21 * * MON-FRI"] },
  "observability": { "enabled": true }
}
